{
	"name": "cyrilingo",
	"private": true,
	"version": "0.10.0-beta",
	"description": "Learn to read the Bulgarian Cyrillic alphabet.",
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"workspaces": [
		"packages/core",
		"apps/web"
	],
	"scripts": {
		"dev": "npm run dev -w @cyrilingo/web --",
		"build": "npm run build -w @cyrilingo/web --",
		"preview": "npm run preview -w @cyrilingo/web --",
		"check": "npm run check --workspaces && tsc -p tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"icons": "node scripts/generate-icons.js",
		"audio": "node --env-file=.env.local scripts/audio/generate.ts",
		"audio:bench": "node --env-file=.env.local scripts/audio/bench.ts"
	},
	"devDependencies": {
		"@cyrilingo/core": "*",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vitest": "^4.1.8"
	}
}
