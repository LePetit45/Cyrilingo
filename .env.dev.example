# Development settings, read by `npm run dev`, `npm run db:migrate`, the tests and `npm run audio`.
# Copy to .env at the repository root and fill in. Never commit .env: it holds secrets.
# Deploying uses .env.example instead.

# Origin of the Vite dev server.
PUBLIC_URL=http://localhost:5173

# A PostgreSQL 17 server of your own, as postgres://user:password@localhost:5432/cyrilingo
DATABASE_URL=
# Server where the tests create their throwaway databases (default: the one of DATABASE_URL).
TEST_DATABASE_URL=

# Google sign-in. Empty turns it off. Authorized redirect URI of the OAuth client:
# http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Azure AI Speech, for read-aloud questions and `npm run audio`. Empty turns read aloud off.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
