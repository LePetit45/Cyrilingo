// Type checks the root files: end-to-end tests and tool configs. Each workspace has its own.
{
	"compilerOptions": {
		"target": "es2023",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["es2023", "dom"],
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true
	},
	"include": ["e2e", "playwright.config.ts", "vitest.config.ts"]
}
