# Copy to .env and fill in. Never commit .env: it holds secrets.
# docker compose reads .env; `npm run dev`, `npm run db:migrate` and the tests read .env, then .env.local.

# Origin the app is served from. In development, the Vite server: http://localhost:5173
PUBLIC_URL=
# Port of the API server (default 3000). Not PORT, which hosting tools often set for the web server.
API_PORT=
# true only behind a reverse proxy that sets X-Forwarded-* headers.
TRUST_PROXY=

# PostgreSQL. In development, with `docker compose up db`:
# postgres://cyrilingo:<POSTGRES_PASSWORD>@localhost:5432/cyrilingo
POSTGRES_PASSWORD=
DATABASE_URL=
# Host port of the development database (default 5432).
DB_PORT=

# Google sign-in. Empty turns it off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Azure AI Speech, for read-aloud questions and `npm run audio`. Empty turns read aloud off.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
