# Copy to .env and fill in. Never commit .env: it holds secrets.
# docker compose reads .env; `npm run dev`, `npm run db:migrate` and the tests read .env too.

# Origin the app is served from. In development, the Vite server: http://localhost:5173
PUBLIC_URL=
# Port of the API server (default 3000). Not PORT, which hosting tools often set for the web server.
API_PORT=
# true only behind a reverse proxy that sets X-Forwarded-* headers.
TRUST_PROXY=
# Port of the deployed stack, where the HTTPS reverse proxy forwards to (default 8080).
WEB_PORT=

# PostgreSQL. Deployed, compose.yaml builds DATABASE_URL from POSTGRES_PASSWORD (letters and
# digits only). In development, DATABASE_URL points at a server of your own.
POSTGRES_PASSWORD=
DATABASE_URL=

# Google sign-in. Empty turns it off. In the Google Cloud console, create an OAuth client of type
# "Web application" with the authorized redirect URI <PUBLIC_URL>/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Azure AI Speech, for read-aloud questions and `npm run audio`. Empty turns read aloud off.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Read-aloud tries all learners together may make in 24 hours (default 500), so the free tier
# cannot be drained.
SPEECH_DAILY_LIMIT=
