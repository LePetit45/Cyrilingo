# Deployment settings, read by compose.yaml. Copy to .env beside compose.yaml (or set them in the
# host's environment) and fill in. Never commit .env: it holds secrets.
# Development uses .env.dev.example instead.

# Origin learners open, in https (the reverse proxy in front of the stack handles TLS).
PUBLIC_URL=
# Port published by the stack, where the reverse proxy forwards to (default 8080).
WEB_PORT=
# true behind a reverse proxy that sets X-Forwarded-* headers.
TRUST_PROXY=true

# Password of the stack's PostgreSQL. Letters and digits only: it goes into the database URL.
POSTGRES_PASSWORD=

# Google sign-in. Empty turns it off. In the Google Cloud console, create an OAuth client of type
# "Web application" with the authorized redirect URI <PUBLIC_URL>/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Azure AI Speech, for read-aloud questions. Empty turns read aloud off.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Read-aloud tries all learners together may make in 24 hours (default 500), so the free tier
# cannot be drained.
SPEECH_DAILY_LIMIT=
